# Shopify Partner → Apps → ListingAI → Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL (ngrok / Cloudflare tunnel / production)
# Production
SHOPIFY_APP_URL=https://listingai.yamshi.app

# Random string — openssl rand -hex 32
SHOPIFY_API_SCOPES=read_products,write_products
SESSION_SECRET=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Billing (USD)
LISTINGAI_STARTER_PRICE_USD=4.99
LISTINGAI_STARTER_LISTINGS=50
LISTINGAI_STARTER_PLAN_NAME=ListingAI SEO Starter
LISTINGAI_PRICE_USD=7.99
LISTINGAI_PLAN_NAME=ListingAI SEO Pro
LISTINGAI_FREE_LISTINGS=25
LISTINGAI_TRIAL_DAYS=15
# Free plan is permanent & monthly (not one-time lifetime)

PORT=3000
HOST=0.0.0.0
SHOPIFY_BILLING_TEST=false

# YAMSHI Pixels (mounted at /pixels on the same host)
PIXELS_APP_URL=https://listingai.yamshi.app/pixels
PIXELS_SHOPIFY_API_KEY=
PIXELS_SHOPIFY_API_SECRET=
PIXELS_SHOPIFY_API_SCOPES=read_orders,write_script_tags,read_script_tags,read_customers
PIXELS_BILLING_TEST=false
